{
  "expo": {
    "name": "secflow",
    "slug": "secflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sec_logo.png",
    "scheme": "secflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/sec_logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/sec_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/sec_logo.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SEC Flow to access your camera to verify gate pass QR codes",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
